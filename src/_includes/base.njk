<!DOCTYPE html>
<html lang="{{ lang or 'it' }}">
  <head>
    <title>{{ title or site.name }}</title>
    <script src="/analytics.js"></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    {% if description %}<meta name="description" content="{{ description }}" />{% endif %}

    <!-- Canonical + anteprima social -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content="{{ ogTitle or title or site.name }}" />
    {% if description %}<meta property="og:description" content="{{ ogDescription or description }}" />{% endif %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}{{ ogImage or site.ogImageDefault }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ ogTitle or title or site.name }}" />
    {% if description %}<meta name="twitter:description" content="{{ ogDescription or description }}" />{% endif %}
    <meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.ogImageDefault }}" />

    {% if jsonLdPerson %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Andrea Bencini",
      "jobTitle": ["Artista", "Data scientist"],
      "url": "{{ site.url }}/",
      "image": "{{ site.url }}{{ site.ogImageDefault }}",
      "sameAs": ["{{ site.instagram }}"],
      "homeLocation": { "@type": "Place", "name": "Firenze, Italia" },
      "knowsAbout": ["Arte generativa", "Sistemi complessi", "Loop Quantum Gravity", "Data science", "Teoria dei grafi"]
    }
    </script>
    {% endif %}

    <!-- Font Google -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Foglio di stile principale -->
    <link rel="stylesheet" href="/style.css" />
    {% for css in extraCss %}<link rel="stylesheet" href="{{ css }}" />
    {% endfor %}
  </head>

  <body class="{{ bodyClass or 'gjs-t-body body' }}">
    <!-- =========================
         HEADER / NAVIGAZIONE (condiviso — si modifica SOLO qui)
         ========================= -->
    <header class="header">
      <div class="header-container">
        <a href="/" class="gjs-t-link group brand-link">
          <div class="group-hover:ring-slate-900/20 brand-mark">AB</div>
          <span class="brand-name">Andrea Bencini</span>
        </a>

        <nav class="primary-nav">
          <a href="/" class="gjs-t-link nav-link" data-i18n="nav.home">Home</a>
          <a href="/works/" class="gjs-t-link nav-link" data-i18n="nav.works">Works</a>
          <div class="nav-dropdown">
            <button type="button" class="gjs-t-link nav-link nav-dropdown-trigger" data-i18n="nav.about">About ▾</button>
            <div class="nav-dropdown-menu">
              <a href="/bio/" class="gjs-t-link nav-link" data-i18n="nav.biography">Biography</a>
              <a href="/concept/" class="gjs-t-link nav-link" data-i18n="nav.concept">Concept</a>
              <a href="/method/" class="gjs-t-link nav-link" data-i18n="nav.method">Method</a>
              <a href="/press/" class="gjs-t-link nav-link" data-i18n="nav.press">Press</a>
            </div>
          </div>
          <a href="/contact/" class="gjs-t-link nav-link" data-i18n="nav.contact">Contact</a>
        </nav>

        <div class="lang-switch" aria-label="Language switch">
          <button type="button" class="lang-btn" data-lang="en">ENG</button>
          <button type="button" class="lang-btn" data-lang="it">ITA</button>
        </div>
      </div>
    </header>

    {{ content | safe }}

    <!-- =========================
         FOOTER (condiviso)
         ========================= -->
    <footer class="footer">
      <div class="footer-container">
        <p class="footer-text">
          © <span id="yearSpan">2025</span>
          <span data-i18n="footer.rights">Andrea Bencini. All rights reserved.</span>
        </p>

        <div class="footer-links">
          <a href="{{ site.instagram }}" class="gjs-t-link footer-link" target="_blank" rel="noopener" data-i18n="footer.instagram">Instagram</a>
          <a href="mailto:{{ site.email }}" class="gjs-t-link footer-link" data-i18n="footer.email">Email</a>
        </div>
      </div>
    </footer>

    <!-- JS -->
    <script type="module" src="/app.js"></script>
  </body>
</html>
